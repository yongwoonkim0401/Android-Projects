        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M54,18 L54,22" />
    <!-- Upper-left tick (at ~135 degrees from right = 45 degrees from top-left) -->
    <!-- 54 + 33*cos(135°) = 54 - 23.3 = 30.7, 56 - 33*sin(135°... wait, angle from 3oclock) -->
    <!-- Let's use 150° from 3oclock (upper-left area): 54+33*cos(150°)=54-28.6=25.4, 56-33*sin(150°)=56-16.5=39.5 -->
    <!-- 120° from 3oclock: 54+33*cos(120°)=54-16.5=37.5, 56-33*sin(120°)=56-28.6=27.4 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M31.5,40 L34,44" />
    <!-- Upper-right tick (60° from 3oclock) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M76.5,40 L74,44" />

    <!-- Needle pointing slightly left of center (about 130° = slightly above horizontal left) -->
    <!-- Needle tip at: 54 + 22*cos(130°) = 54-14.1=39.9, 56 - 22*sin(130°) = 56-16.8=39.2 -->
    <path
        android:strokeColor="#FF5252"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M54,56 L40,39" />

