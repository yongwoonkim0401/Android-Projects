<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101410"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="폰 CCTV"
            android:textColor="#EAF7EA"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="중지됨"
            android:textColor="#9FD79F"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="#000000"
            android:contentDescription="미리보기"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="CCTV 시작"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="접속 주소"
            android:textColor="#7FBF7F"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#1B241B"
            android:textColor="#EAF7EA"
            android:textIsSelectable="true"
            android:text="-"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="브라우저 열기" />

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="주소 복사" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="접속 토큰"
            android:textColor="#7FBF7F"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:background="#1B241B"
                android:padding="8dp"
                android:text="-"
                android:textColor="#EAF7EA"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNewToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="재발급" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="포트"
            android:textColor="#7FBF7F"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1B241B"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="10dp"
                android:text="8080"
                android:textColor="#EAF7EA" />

            <Button
                android:id="@+id/btnApplyPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="적용" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="재부팅 후 자동 시작"
            android:textColor="#EAF7EA" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="배터리 최적화 제외 설정" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="• 폰과 PC가 같은 Wi‑Fi 에 있어야 접속됩니다.\n• 위 주소를 다른 기기 브라우저에 입력하면 영상과 제어 패널이 열립니다.\n• 화면을 꺼도 계속 동작하며, 충전기를 연결해 두는 것을 권장합니다.\n• 토큰은 비밀번호입니다. 외부에 노출하지 마세요."
            android:textColor="#8FB88F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
