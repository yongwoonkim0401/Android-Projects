<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen map -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fixed crosshair at the screen center = current fake location -->
    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:contentDescription="현재 가짜 위치"
        android:src="@drawable/ic_crosshair" />

    <!-- Row 1: Fake GPS ON/OFF button + route auto-move ON/OFF button + "return to current location" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationY="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/switch_chip_bg"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStopButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="60dp"
            android:layout_height="34dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            android:text="OFF"
            android:contentDescription="Fake GPS 시작/정지" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routeToggleButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="60dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            android:text="OFF"
            android:contentDescription="자동 이동(경로) 시작/정지" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="#55FFFFFF" />

        <ImageButton
            android:id="@+id/myLocationButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_my_location"
            android:contentDescription="현재 위치로 되돌아가기" />
    </LinearLayout>

    <!-- Row 2: route start/end point picker + speed -/+ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationY="108dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/switch_chip_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setRoutePointsButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#616161"
            android:text="출발점/도착점 지정" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#55FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speedMinusButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#616161"
            android:text="−"
            android:contentDescription="속도 감소" />

        <TextView
            android:id="@+id/speedValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="12 km/h" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speedPlusButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#616161"
            android:text="+"
            android:contentDescription="속도 증가" />
    </LinearLayout>

    <!-- Non-interactive status overlay (passes touches through to the map) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:clickable="false"
        android:focusable="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:text="■ 멈춤 상태" />

    <TextView
        android:id="@+id/coordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="34dp"
        android:clickable="false"
        android:focusable="false"
        android:textColor="#EEEEEE"
        android:textSize="12sp"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:text="" />
</FrameLayout>
