# Copy this file to `keystore.properties` (same folder) and fill in your own values.
# keystore.properties is gitignored — never commit real passwords.
#
# storeFile: absolute path is safest. Use forward slashes or escaped backslashes.
#   e.g. C:/Users/adca/KeyAndroidYwkim.jks
storeFile=C:/Users/adca/KeyAndroidYwkim.jks
storePassword=
keyAlias=
keyPassword=
